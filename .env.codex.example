# Copy into .env (or merge these settings into your existing .env).
# Install the official Codex CLI and run `codex login` first.
TRADINGAGENTS_LLM_PROVIDER=codex
TRADINGAGENTS_QUICK_THINK_LLM=default
TRADINGAGENTS_DEEP_THINK_LLM=default
TRADINGAGENTS_QUICK_THINK_PROVIDER=codex
TRADINGAGENTS_DEEP_THINK_PROVIDER=codex
TRADINGAGENTS_CODEX_COMMAND=codex
TRADINGAGENTS_CODEX_TIMEOUT=1800
TRADINGAGENTS_OPENAI_REASONING_EFFORT=low
TRADINGAGENTS_OUTPUT_LANGUAGE=Vietnamese
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
# No OPENAI_API_KEY or CODEX_API_KEY is needed.
# Clear backend URL, temperature, max_tokens and LLM retry overrides for Codex.
